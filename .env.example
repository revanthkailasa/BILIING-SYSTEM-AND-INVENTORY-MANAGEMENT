FIREBASE_AUTH_DOMAIN=billingsystemandinventorysyste.firebaseapp.com
FIREBASE_PROJECT_ID=billingsystemandinventorysyste
FIREBASE_STORAGE_BUCKET=billingsystemandinventorysyste.firebasestorage.app
