# ==================== ADMIN ACCOUNT ====================
# Create these accounts in Firebase Console first!
ADMIN_EMAIL=admin@saikrishna.local
ADMIN_PASSWORD=SecureAdminPass@123

# ==================== STAFF ACCOUNTS ====================
STAFF_EMAIL=staff@saikrishna.local
STAFF_PASSWORD=SecureStaffPass@456

# ==================== SESSION TIMEOUT ====================
# Session timeout in milliseconds (15 minutes default)
SESSION_TIMEOUT=900000

# ==================== SECURITY SETTINGS ====================
# Enable/Disable 2FA
ENABLE_2FA=true

# Enable password reset email
ENABLE_PASSWORD_RESET=true

# Require email verification
REQUIRE_EMAIL_VERIFICATION=true

# Max login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration in minutes
LOCKOUT_DURATION=15

# ==================== API ENDPOINTS ====================
# For future backend integration
API_BASE_URL=https://api.yourdomain.com
API_VERSION=v1

# ==================== LOGGING ====================
# Enable debug logging
DEBUG_MODE=false

# Log level: error, warn, info, debug
LOG_LEVEL=info
